---
import type { Project } from "../lib/content";
import { formatDate } from "../lib/content";
import { getResource } from "../lib/resource";

interface Props {
  project: Project;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel = "h3" } = Astro.props;
const { data } = project;
const resource = await getResource(project);
const Heading = headingLevel;
---

<a class="rch-card" href={`/projects/${project.id}/`}>
  <p class="rch-eyebrow">{data.kind}</p>
  <Heading class="rch-card-title">{data.title}</Heading>
  <p class="rch-card-body">{data.summary}</p>
  <div class="rch-card-foot">
    {data.draft && <span class="rch-badge rch-badge-warning">Draft</span>}
    {resource.archived && <span class="rch-badge rch-badge-warning">Archived</span>}
    {data.topics.slice(0, 3).map((t) => <span class="rch-badge">{t}</span>)}
    {
      resource.updatedAt && (
        <span class="card-updated">
          Updated <time datetime={resource.updatedAt.toISOString()}>{formatDate(resource.updatedAt)}</time>
        </span>
      )
    }
  </div>
</a>
