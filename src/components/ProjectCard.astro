---
import type { Project } from "../lib/content";
import { formatDate } from "../lib/content";
import { getRepo } from "../lib/github";

interface Props {
  project: Project;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel = "h3" } = Astro.props;
const { data } = project;
const repo = await getRepo(data.repo);
const Heading = headingLevel;
---

<a class="rch-card" href={`/projects/${project.id}/`}>
  <p class="rch-eyebrow">{data.kind}</p>
  <Heading class="rch-card-title">{data.title}</Heading>
  <p class="rch-card-body">{data.summary}</p>
  <div class="rch-card-foot">
    {data.draft && <span class="rch-badge rch-badge-warning">Draft</span>}
    {repo?.archived && <span class="rch-badge rch-badge-warning">Archived</span>}
    {repo?.language && <span class="rch-badge">{repo.language}</span>}
    {data.topics.slice(0, 3).map((t) => <span class="rch-badge">{t}</span>)}
    {
      repo && (
        <span class="card-updated">
          Updated <time datetime={repo.pushedAt.toISOString()}>{formatDate(repo.pushedAt)}</time>
        </span>
      )
    }
  </div>
</a>
