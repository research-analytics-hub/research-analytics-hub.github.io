---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <div class="rch-container page">
    <header class="page-head">
      <p class="rch-eyebrow">Error 404</p>
      <h1>We couldn't find that page</h1>
      <p class="lead">
        It may have moved, or a project may have been renamed. The project list is the best place to look next.
      </p>
      <div class="actions">
        <a class="rch-btn rch-btn-primary" href="/projects/">Browse projects</a>
        <a class="rch-btn rch-btn-secondary" href="/">Go to the home page</a>
      </div>
    </header>
  </div>
</Base>
