---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getProjects, type Project } from "../../lib/content";
import { getRepo } from "../../lib/github";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { data } = project;
const { Content } = await render(project);
const repo = await getRepo(data.repo);
const repoUrl = repo?.url ?? `https://github.com/${data.repo}`;
---

<Base title={data.title} description={data.summary}>
  <article class="rch-container page">
    <header class="page-head">
      <p class="rch-eyebrow">{data.kind}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
      <div class="actions">
        <a class="rch-btn rch-btn-primary" href={repoUrl} target="_blank" rel="noopener noreferrer">View the repository</a>
        {data.links.map((l) => <a class="rch-btn rch-btn-secondary" href={l.url}>{l.label}</a>)}
      </div>
    </header>

    {
      data.draft && (
        <aside class="rch-callout rch-callout-warning" role="note">
          <span class="rch-callout-label">Draft</span>
          <p class="rch-callout-body">This listing is marked as a draft and won't appear on the live site.</p>
        </aside>
      )
    }
    {
      repo?.archived && (
        <aside class="rch-callout rch-callout-warning" role="note">
          <span class="rch-callout-label">Archived</span>
          <p class="rch-callout-body">
            The maintainers have archived this repository. It still works as a reference, but it no longer receives
            updates.
          </p>
        </aside>
      )
    }

    <div class="project-layout">
      <div class="rch-prose">
        <Content />
      </div>
      <aside class="project-meta" aria-label="Project details">
        <dl>
          <div>
            <dt>Maintained by</dt>
            <dd>
              <ul>
                {
                  data.maintainers.map((m) => (
                    <li>
                      {m.github ? <a target="_blank" rel="noopener noreferrer" href={`https://github.com/${m.github}`}>{m.name}</a> : m.name}
                      {m.affiliation && <span class="meta-sub">{m.affiliation}</span>}
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
          <div>
            <dt>Repository</dt>
            <dd><a href={repoUrl} target="_blank" rel="noopener noreferrer"><code>{data.repo}</code></a></dd>
          </div>
          <div>
            <dt>License</dt>
            <dd>{repo ? (repo.license ?? "None detected; check the repository") : "See the repository"}</dd>
          </div>
          {
            repo && (
              <div>
                <dt>Last updated</dt>
                <dd>
                  <time datetime={repo.pushedAt.toISOString()}>{formatDate(repo.pushedAt)}</time>
                </dd>
              </div>
            )
          }
          {
            data.topics.length > 0 && (
              <div>
                <dt>Topics</dt>
                <dd class="badges">
                  {data.topics.map((t) => (
                    <span class="rch-badge">{t}</span>
                  ))}
                </dd>
              </div>
            )
          }
          <div>
            <dt>Listed</dt>
            <dd><time datetime={data.added.toISOString().slice(0, 10)}>{formatDate(data.added)}</time></dd>
          </div>
        </dl>
      </aside>
    </div>

    <p class="back"><a class="rch-link" href="/projects/">Back to all projects</a></p>
  </article>
</Base>
