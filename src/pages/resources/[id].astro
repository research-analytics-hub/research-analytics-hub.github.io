---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getProjects, type Project } from "../../lib/content";
import { getResource } from "../../lib/resource";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { data } = project;
const { Content } = await render(project);
const resource = await getResource(project);
---

<Base title={data.title} description={data.summary}>
  <article class="rch-container page">
    <header class="page-head">
      <p class="rch-eyebrow">{data.kind}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
      <div class="actions">
        <a class="rch-btn rch-btn-primary" href={resource.href} target="_blank" rel="noopener noreferrer">{resource.buttonLabel}</a>
        {data.links.map((l) => <a class="rch-btn rch-btn-secondary" href={l.url}>{l.label}</a>)}
      </div>
    </header>

    {
      data.draft && (
        <aside class="rch-callout rch-callout-warning" role="note">
          <span class="rch-callout-label">Draft</span>
          <p class="rch-callout-body">This listing is marked as a draft and won't appear on the live site.</p>
        </aside>
      )
    }
    {
      resource.archived && (
        <aside class="rch-callout rch-callout-warning" role="note">
          <span class="rch-callout-label">Archived</span>
          <p class="rch-callout-body">
            The maintainers have archived this {resource.isGitHub ? "repository" : "resource"}. It still works as a
            reference, but it no longer receives updates.
          </p>
        </aside>
      )
    }

    <div class="project-layout">
      <div class="rch-prose">
        <Content />
      </div>
      <aside class="project-meta" aria-label="Project details">
        <dl>
          <div>
            <dt>Maintained by</dt>
            <dd>
              <ul>
                {
                  data.maintainers.map((m) => (
                    <li>
                      { m.github ? (
                        <a target="_blank" rel="noopener noreferrer" href={`https://github.com/${m.github}`}>{m.name}</a>
                      ) : m.email ? (
                        <a href={`mailto:${m.email}`}>{m.name}</a>
                      ) : (
                        m.name
                      )}
                      {m.affiliation && <span class="meta-sub">{m.affiliation}</span>}
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
          <div>
            <dt>{resource.isGitHub ? "Repository" : "Source"}</dt>
            <dd>
              <a href={resource.href} target="_blank" rel="noopener noreferrer">
                {resource.isGitHub ? <code>{resource.sourceText}</code> : <span class="source-url">{resource.sourceText}</span>}
              </a>
            </dd>
          </div>
          <div>
            <dt>License</dt>
            <dd>
              {
                resource.license === null ? (
                  resource.licenseFallback
                ) : resource.licenseUrl ? (
                  <a href={resource.licenseUrl} target="_blank" rel="noopener noreferrer">{resource.license}</a>
                ) : (
                  resource.license
                )
              }
            </dd>
          </div>
          {
            resource.updatedAt && (
              <div>
                <dt>Last updated</dt>
                <dd>
                  <time datetime={resource.updatedAt.toISOString()}>{formatDate(resource.updatedAt)}</time>
                </dd>
              </div>
            )
          }
          {
            data.topics.length > 0 && (
              <div>
                <dt>Topics</dt>
                <dd class="badges">
                  {data.topics.map((t) => (
                    <span class="rch-badge">{t}</span>
                  ))}
                </dd>
              </div>
            )
          }
          <div>
            <dt>Listed</dt>
            <dd><time datetime={data.added.toISOString().slice(0, 10)}>{formatDate(data.added)}</time></dd>
          </div>
        </dl>
      </aside>
    </div>

    <p class="back"><a class="rch-link" href="/resources/">Back to all resources</a></p>
  </article>
</Base>
